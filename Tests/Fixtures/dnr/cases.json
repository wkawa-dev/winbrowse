[
  { "name": "block: plain url filter applies to subresources only",
    "rule": { "id": 1, "action": { "type": "block" }, "condition": { "urlFilter": "/ads/banner." } } },
  { "name": "block: pure host filter also blocks documents",
    "rule": { "id": 2, "action": { "type": "block" }, "condition": { "urlFilter": "||tracker.example^" } } },
  { "name": "block: request domains become one rule per domain",
    "rule": { "id": 3, "action": { "type": "block" }, "condition": { "requestDomains": ["a.example", "b.example"] } } },
  { "name": "block: case-sensitive filter",
    "rule": { "id": 4, "action": { "type": "block" }, "condition": { "urlFilter": "/AdFrame/", "isUrlFilterCaseSensitive": true } } },
  { "name": "types: scripts and images",
    "rule": { "id": 10, "action": { "type": "block" }, "condition": { "urlFilter": "||ads.example^", "resourceTypes": ["script", "image", "xmlhttprequest"] } } },
  { "name": "types: sub_frame only is a child-frame document",
    "rule": { "id": 11, "action": { "type": "block" }, "condition": { "urlFilter": "||frames.example^", "resourceTypes": ["sub_frame"] } } },
  { "name": "types: main_frame only is a top-frame document",
    "rule": { "id": 12, "action": { "type": "block" }, "condition": { "urlFilter": "||bad.example^", "resourceTypes": ["main_frame"] } } },
  { "name": "types: excluded image also excludes svg documents",
    "rule": { "id": 13, "action": { "type": "block" }, "condition": { "urlFilter": "/pixel", "excludedResourceTypes": ["image", "sub_frame"] } } },
  { "name": "domains: initiator domains become if-domain",
    "rule": { "id": 20, "action": { "type": "block" }, "condition": { "urlFilter": "/promo/", "initiatorDomains": ["News.example"], "domainType": "thirdParty" } } },
  { "name": "domains: excluded initiator domains become unless-domain",
    "rule": { "id": 21, "action": { "type": "block" }, "condition": { "urlFilter": "/promo/", "excludedInitiatorDomains": ["shop.example"], "domainType": "firstParty" } } },
  { "name": "domains: only wildcard initiators drop the rule",
    "rule": { "id": 22, "action": { "type": "block" }, "condition": { "urlFilter": "/promo/", "initiatorDomains": ["*.example"] } } },
  { "name": "allow: becomes ignore-previous-rules",
    "rule": { "id": 30, "action": { "type": "allow" }, "condition": { "urlFilter": "||cdn.example/player.js" } } },
  { "name": "allowAllRequests: exempts a whole top-level site",
    "rule": { "id": 31, "action": { "type": "allowAllRequests" }, "condition": { "urlFilter": "||trusted.example^", "resourceTypes": ["main_frame"] } } },
  { "name": "allowAllRequests: sub_frame only is dropped",
    "rule": { "id": 32, "action": { "type": "allowAllRequests" }, "condition": { "urlFilter": "||trusted.example^", "resourceTypes": ["sub_frame"] } } },
  { "name": "denyallow: block with excluded request domains",
    "rule": { "id": 40, "action": { "type": "block" }, "condition": { "urlFilter": "*", "resourceTypes": ["script"], "initiatorDomains": ["site.example"], "excludedRequestDomains": ["cdn.example"] } } },
  { "name": "upgradeScheme: becomes make-https",
    "rule": { "id": 50, "action": { "type": "upgradeScheme" }, "condition": { "requestDomains": ["insecure.example"] } } },
  { "name": "redirect: image redirect becomes block",
    "rule": { "id": 60, "action": { "type": "redirect", "redirect": { "extensionPath": "/web_accessible_resources/1x1.gif" } }, "condition": { "urlFilter": "||pixel.example^", "resourceTypes": ["image"] } } },
  { "name": "dropped: script redirect",
    "rule": { "id": 70, "action": { "type": "redirect", "redirect": { "extensionPath": "/web_accessible_resources/noop.js" } }, "condition": { "urlFilter": "||ads.example/ad.js", "resourceTypes": ["script"] } } },
  { "name": "dropped: url transform",
    "rule": { "id": 71, "action": { "type": "redirect", "redirect": { "transform": { "queryTransform": { "removeParams": ["utm_source"] } } } }, "condition": { "urlFilter": "?utm_source=", "resourceTypes": ["image"] } } },
  { "name": "dropped: regex filter",
    "rule": { "id": 72, "action": { "type": "block" }, "condition": { "regexFilter": "^https://[a-z]+\\.example/ad" } } },
  { "name": "dropped: request methods",
    "rule": { "id": 73, "action": { "type": "block" }, "condition": { "urlFilter": "/collect", "requestMethods": ["post"] } } },
  { "name": "dropped: response headers",
    "rule": { "id": 74, "action": { "type": "block" }, "condition": { "urlFilter": "/x", "responseHeaders": [{ "header": "content-type", "values": ["text/html"] }] } } },
  { "name": "dropped: non-ascii url filter",
    "rule": { "id": 75, "action": { "type": "block" }, "condition": { "urlFilter": "||bücher.example^" } } },
  { "name": "dropped: modifyHeaders action",
    "rule": { "id": 76, "action": { "type": "modifyHeaders", "responseHeaders": [{ "header": "set-cookie", "operation": "remove" }] }, "condition": { "urlFilter": "/x" } } }
]
